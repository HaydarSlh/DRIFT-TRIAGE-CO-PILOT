# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Environment & secrets
.env

# Data (don't commit large CSVs)
data/*.csv
data/*.parquet    # optional – keep splits if they're small and you want reproducibility

# MLflow artifacts (runs, registry DB)
mlruns/
mlruns.db         # if you used SQLite backend

# Model artifacts
artifacts/*.pkl
artifacts/*.joblib
artifacts/*.json   # threshold, reference stats – commit only if you want to share them

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test snapshots (will be regenerated in CI)
tests/*.npy       # or keep it if you want the fidelity snapshot under version control