# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db
# Inside Docker Compose, use the service name "postgres" and port 5432.
# For local (non-Docker) dev, use localhost:5433 (the mapped port).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/2
QUEUE_REDIS_URL=redis://redis:6379/3

# ── MLflow ────────────────────────────────────────────────────────────────────
# Inside Docker, platform service exposes MLflow on port 5000.
MLFLOW_TRACKING_URI=http://platform:5000

# ── LLM provider ──────────────────────────────────────────────────────────────
# Set exactly ONE of these. LLM_PROVIDER selects which key is active.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here
GOOGLE_API_KEY=your-key-here

# ── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_URL=http://platform:8000
PLATFORM_WEBHOOK_SECRET=supersecrets

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_CALLBACK_URL=http://dashboard:8501
SECRET_KEY=change-me-in-production
