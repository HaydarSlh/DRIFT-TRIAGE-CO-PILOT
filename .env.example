# Postgres
POSTGRES_USER=drift
POSTGRES_PASSWORD=secret
POSTGRES_DB=drift_triage
DATABASE_URL=postgresql+asyncpg://drift:secret@localhost:5433/drift_triage

# Redis
REDIS_URL=redis://redis:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Anthropic / LLM
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here
GOOGLE_API_KEY=your-key-here
LLM_PROVIDER=google

# Platform
PLATFORM_URL=http://platform:8000
PLATFORM_WEBHOOK_SECRET=your-webhook-secret-here

# Dashboard callback (optional)
DASHBOARD_CALLBACK_URL=http://dashboard:8501

# Auth (optional)
SECRET_KEY=change-me
