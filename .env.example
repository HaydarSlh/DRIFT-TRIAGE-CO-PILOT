# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/db

# Redis
REDIS_URL=redis://redis:6379/0
QUEUE_REDIS_URL=redis://redis:6379/3

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Anthropic / LLM
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here
GOOGLE_API_KEY=your-key-here
LLM_PROVIDER=anthropic

# Platform
PLATFORM_URL=http://platform:8000
PLATFORM_WEBHOOK_SECRET=your-webhook-secret-here

# Dashboard callback (optional)
DASHBOARD_CALLBACK_URL=http://dashboard:8501

# Auth (optional)
SECRET_KEY=change-me
